entrypoint = "server.ts"
modules = ["nodejs-20"]
hidden = [".config", "package-lock.json"]
run = "npm run start"

[nix]
channel = "stable-24_11"

# Expose the CMS HTTP + WebSocket server (TomorrowOS Control Panel at /).
# Publish readiness: probe GET /status (public). Do not rely on auth redirects from /.
[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "autoscale"
ignorePorts = false
# Prefer Reserved VM in the Publishing UI for persistent WebSockets.
# If the UI allows a health/readiness path, set it to /status.
